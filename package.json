{
    "allowScripts": {
        "@parcel/watcher": false,
        "esbuild": false,
        "unrs-resolver": false
    },
    "author": "@ts-all",
    "bugs": {
        "url": "https://github.com/ts-all/index/issues"
    },
    "description": "A set of utilities for TypeScript projects",
    "devDependencies": {
        "@ts-all/eslint-config": "^0.3.12",
        "@types/node": "^26.5.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "jest": "^30.5.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "esnext": "./dist/esm/index.js",
    "exports": {
        ".": {
            "default": "./dist/esm/index.js",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.cjs",
            "types": "./dist/types/index.d.ts"
        }
    },
    "homepage": "https://github.com/ts-all/index#readme",
    "keywords": [
        "typescript",
        "utility"
    ],
    "license": "MIT",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "name": "@ts-all/index",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ts-all/index.git"
    },
    "scripts": {
        "build": "jest && rimraf ./dist && tsc -p ./tsconfig.cjs.json && tsc -p ./tsconfig.esm.json && tsc -p ./tsconfig.types.json",
        "debug": "tsx ./src/app",
        "deploy": "npm run build && npm publish",
        "lint": "tsc && eslint --concurrency auto",
        "test": "jest"
    },
    "type": "module",
    "types": "./dist/types/index.d.ts",
    "version": "0.2.15"
}
